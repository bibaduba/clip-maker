# Google OAuth is optional. Without these values, login/password still works.
# Redirect URI in Google Cloud: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Optional local storage location.
MEDIA_STORAGE_PATH=storage

# Optional paths when media tools are not available in PATH (especially on Windows).
WHISPER_CLI=whisper-cli
WHISPER_MODEL=storage/models/ggml-small.bin
# Optional ASR v2 overrides. Defaults point to the isolated local GPU environment.
WHISPERX_PYTHON=.venv-asr/Scripts/python.exe
WHISPERX_MODEL=large-v3-turbo
WHISPERX_DEVICE=auto
# Optional: enables WhisperX speaker diarization after accepting access to
# pyannote/speaker-diarization-community-1 on Hugging Face.
HUGGINGFACE_TOKEN=
LLAMA_CLI=llama-completion
CLIP_LLM_MODEL=storage/models/Qwen3-4B-Q4_K_M.gguf

# Optional AI B-roll planner. The key stays server-side.
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_VISION_MODEL=kimi-k2.5
# Ограничение числа кандидатов с визуальным анализом, чтобы контролировать расход API.
MEDIA_VISUAL_MAX_CANDIDATES=8
KIMI_API_BASE=https://api.moonshot.ai/v1
# Free stock video API used by the first B-roll implementation.
PEXELS_API_KEY=

# Local safety limits. Public deployment should enforce per-user quotas as well.
MEDIA_MAX_SOURCE_SECONDS=7200
MEDIA_TOTAL_ANALYSIS_SECONDS=7200
MEDIA_ANALYSIS_CHUNK_SECONDS=600
MEDIA_MAX_DOWNLOAD_SIZE=1G
# Для роликов с возрастным ограничением. Надёжнее экспортировать cookies.txt
# из авторизованного аккаунта YouTube и указать путь к нему. Файл содержит
# секреты сессии: не добавляйте его в Git и никому не отправляйте.
YTDLP_COOKIES_FILE=
# Альтернатива для локального компьютера: chrome, edge, firefox или значение
# вида chrome:C:\Users\you\AppData\Local\Google\Chrome\User Data\Profile 1
YTDLP_COOKIES_FROM_BROWSER=
# Optional fixed yt-dlp wall-clock limit. When omitted, the worker uses twice
# the analyzed video duration with a 20-minute minimum.
# MEDIA_DOWNLOAD_TIMEOUT_MINUTES=120
MEDIA_MIN_FREE_GB=3
