{
  "name": "clip-maker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "doctor": "node --import tsx scripts/doctor.ts",
    "media:benchmark": "node --import tsx scripts/media/benchmark.ts",
